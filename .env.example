# Copy to .env.local to override any of these locally.
# .env.local is gitignored (.gitignore excludes *.local).

# Google Analytics 4 measurement ID.
#
# Production builds read this from netlify.toml's [build.environment], where the
# real value already lives - you do NOT need to set it to deploy.
#
# Leave it unset locally. src/routes/__root.tsx requires BOTH this value and a
# production build before it emits the gtag script, so `npm run dev` never sends
# data to the live property. Setting it here does not change that; to actually
# exercise events locally you need a production build.
VITE_GA_MEASUREMENT_ID=
